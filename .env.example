# Vorlage für .env — echte Werte gehören in eine Datei namens ".env"
# (liegt neben dieser Datei, wird von Next.js automatisch geladen, ist NICHT
# im Git-Repository, siehe .gitignore). Nach jeder Änderung an .env: den
# Node.js-Prozess in Plesk neu starten ("App neu starten"), sonst greifen
# die neuen Werte nicht.
#
# Variablen mit NEXT_PUBLIC_ landen im Browser-Bundle — dort NIE geheime
# Schlüssel eintragen. Alles andere bleibt serverseitig.

# --- Umgebung -----------------------------------------------------------
# "staging" (Vorschau, noindex, Testmodus) oder "production" (Live-Seite)
NEXT_PUBLIC_SITE_ENV=staging

# --- Stripe ---------------------------------------------------------------
# dashboard.stripe.com -> Entwicklertools -> API-Schlüssel
# Im Testmodus beginnen die Schlüssel mit pk_test_ / sk_test_,
# live mit pk_live_ / sk_live_. Auf Vorschau IMMER die test-Schlüssel.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Wird erst gebraucht, wenn der Checkout-Webhook eingerichtet ist
# (dashboard.stripe.com -> Entwicklertools -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Google Places API (New) ----------------------------------------------
# console.cloud.google.com -> APIs & Dienste -> Anmeldedaten
# Dieser Key wird nur serverseitig (Cron/Abruf) verwendet, nie im Browser.
GOOGLE_PLACES_API_KEY=...
# Zu finden z. B. über https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=...

# --- Shop-Verwaltung (Admin-PWA) -------------------------------------------
# SQLite-Datei bewusst AUSSERHALB von app/ (überlebt git-Deploys).
DATABASE_URL="file:/var/www/vhosts/sport-schuh-steiner.at/storage/db/shop.db"
# Ordner für hochgeladene Produktfotos, ebenfalls außerhalb von app/.
PRODUCT_PHOTOS_DIR=/var/www/vhosts/sport-schuh-steiner.at/storage/produktfotos
# Zufälliger, langer Schlüssel zum Verschlüsseln der Admin-Login-Session
# (mind. 32 Zeichen, z. B. `openssl rand -hex 32`).
SESSION_SECRET=...
# Nur beim ersten `npm run seed` verwendet, um den ersten Admin-Zugang
# anzulegen.
ADMIN_SEED_EMAIL=...
ADMIN_SEED_PASSWORD=...
