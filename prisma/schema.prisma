generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ProductStatus {
  entwurf
  veroeffentlicht
  verkauft
}

enum ShopCategory {
  laufen
  wandern
  ski
  schneeschuh
  beruf
  barfuss
}

enum Gender {
  Damen
  Herren
  Kinder
}

enum OrderStatus {
  bezahlt
  storniert
  erstattet
}

enum OrderType {
  produkt
  gutschein
}

model Product {
  id            String        @id @default(cuid())
  slug          String        @unique
  brand         String
  model         String
  title         String
  category      ShopCategory
  categoryLabel String
  gender        Gender
  size          Float
  sizeDetails   String
  price         Int
  oldPrice      Int?
  badge         String?
  isRestposten  Boolean       @default(false)
  isNew         Boolean       @default(false)
  status        ProductStatus @default(entwurf)
  /// Freitext für das "Beschreibung"-Accordion auf der Produktseite.
  description     String?
  /// Freitext für "Details & Material".
  detailsMaterial String?
  /// Freitext für "Passform-Tipp aus dem Geschäft".
  fitTip          String?
  /// Statisches Bild aus public/images (Altbestand vor der Admin-PWA). Neue
  /// Produkte nutzen stattdessen `photos`.
  legacyImage   String?
  /// CSS object-fit/position für Bilder mit freigestelltem/schwarzem Grund
  /// (siehe ProductActions/ShopBrowser).
  imageFit      String?
  imagePosition String?
  photos        ProductPhoto[]
  orders        Order[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model ProductPhoto {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  dateiname String
  sortIndex Int      @default(0)
  createdAt DateTime @default(now())
  /// Gesetzt, sobald die physische Datei automatisch gelöscht wurde (1 Monat
  /// nach Verkauf, siehe scripts/cleanup-old-photos.mts). Der Datensatz
  /// selbst bleibt zu Statistikzwecken erhalten.
  deletedAt DateTime?
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  stripeSessionId       String      @unique
  stripePaymentIntentId String?
  productId             String?
  product               Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Titel zum Kaufzeitpunkt – bleibt lesbar, auch wenn das Produkt später gelöscht wird.
  productTitle          String
  /// In Cent, wie Stripe (im Unterschied zu Product.price, das volle Euro sind).
  amountTotal           Int
  currency              String      @default("eur")
  customerEmail         String?
  customerName          String?
  customerPhone         String?
  /// Rechnungsadresse (Stripe customer_details.address).
  billingAddressLine1   String?
  billingAddressLine2   String?
  billingCity           String?
  billingPostalCode     String?
  billingCountry        String?
  /// Lieferadresse, falls abweichend erfasst (Stripe collected_information.shipping_details).
  shippingName          String?
  shippingAddressLine1  String?
  shippingAddressLine2  String?
  shippingCity          String?
  shippingPostalCode    String?
  shippingCountry       String?
  /// Von Stripe gehosteter Beleg (Kassenbon) zur Zahlung.
  receiptUrl            String?
  /// Von Stripe gehostete Rechnung, falls Rechnungsstellung aktiviert ist.
  invoiceUrl            String?
  invoicePdfUrl         String?
  status                OrderStatus @default(bezahlt)
  type                  OrderType   @default(produkt)
  /// Nur für type=gutschein: Gutscheincode, z. B. "SSS-4F7K-2Q9X" (dient auch
  /// als Bearer-Token für den PDF-Download-Link, siehe /api/gutscheine/[code]/pdf).
  voucherCode           String?     @unique
  /// Vorname der beschenkten Person (Personalisierung auf dem Gutschein), optional.
  voucherRecipientName  String?
  /// Persönliche Nachricht auf dem Gutschein, optional.
  voucherMessage        String?
  /// Vom Personal im Geschäft gesetzt, sobald der Gutschein eingelöst wurde.
  voucherRedeemed       Boolean     @default(false)
  voucherRedeemedAt     DateTime?
  createdAt             DateTime    @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}
